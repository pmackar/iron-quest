{
  "name": "iron-quest-server",
  "version": "1.0.0",
  "description": "Backend API for Iron Quest workout tracker",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run db:init || true",
    "db:init": "node src/db/init.js",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "cron:nightly": "node src/jobs/run-cron.js nightly",
    "cron:weekly": "node src/jobs/run-cron.js weekly",
    "cron:wagers": "node src/jobs/run-cron.js wagers",
    "cron:encounters": "node src/jobs/run-cron.js encounters",
    "cron:cleanup": "node src/jobs/run-cron.js cleanup"
  },
  "keywords": [
    "fitness",
    "workout",
    "tracker",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11"
  }
}
